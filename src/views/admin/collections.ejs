<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/admin.css" />

<!-- Experimental Design -->
<div class="container mx-auto mt-3 pt-3">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 style="color: maroon;">Digital Archives Collections</h2>
        </div>
        <div>
          <a href="/admin/collections?view=add-collection" class="btn btn-sm btn-maroon p-2">
            <i class="bi bi-plus-lg me-1"></i> Add Collection
          </a>
        </div>
      </div>
      
      <!-- Fetch Collections -->

      <div class="d-flex gap-4 mw-100">
        <h4 class="text-muted medium ps-3">Collections:</h4>
        <% if (locals.collections && collections.length > 0) { %>
          <% collections.forEach(coll => { %>
          <p <%= (selectedCollection && selectedCollection.id === coll.id) ? 'open' : '' %> class="mb-2">
            <span class="btn btn-light btn-sm px-4 border <%= (selectedCollection && selectedCollection.id === coll.id && view === 'overview') ? 'bg-light' : '' %>">
              <a style="color: maroon; text-decoration: none;" href="/admin/collections?id=<%= coll.id %>&view=collection_overview" 
                  <%= (selectedCollection && selectedCollection.id === coll.id) ? 'fw-bold' : '' %>">
                <i class="bi bi-boxes me-2 <%= (selectedCollection && selectedCollection.id === coll.id) ? 'text-maroon' : 'text-maroon' %>"></i>
                <%= coll.name %>
              </a>
            </span></p>

          <% }) %>
        <% } else { %>
          <p class="text-muted small ps-3">No collections found.</p>
        <% } %>
      </div>
        

      <br />

      <!-- Error Message -->
      <% if (locals.error_msg && error_msg.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <!-- End Error Message -->
       
      <hr> 

      <div class="container-fluid mx-auto justify-content-between align-items-center">
      <div class="row h-100">
    
    
    <!-- Content Area -->
    <main class="col p-5 overflow-auto justify-content-between align-items-center">
      <!-- FLASH MESSAGES -->
      <% if (locals.success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (locals.error_msg && error_msg.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <section id="content-display">
        <% if ((!locals.collections || collections.length === 0) && view !== 'add-collection') { %>
            <div class="text-center py-5">
                <i class="bi bi-folder-x text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">No available details yet</h5>
                <p class="text-secondary small">Start by adding a new collection.</p>
                <a href="/admin/collections?view=add-collection" class="btn btn-maroon btn-sm mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Create Collection
                </a>
            </div>
        <% } else { %>
            <%# Map views to specific partials %>
            <% if (view === 'collection_overview') { %> 
                <%- include('./partials/_collection_overview') %> 
            <% } else if (view === 'edit_collection') { %> 
                <%- include('./partials/_edit_collection') %> 
            <% } else if (view === 'box_details') { %> 
                <%- include('./partials/_box_details') %> 
            <% } else if (view === 'folder-details') { %> 
                <%- include('./partials/_folder_details') %> 
            <% } else if (view === 'item-details') { %> 
                <%- include('./partials/_item_details') %> 
            <% } else if (view === 'add-collection') { %> 
                <%- include('./partials/_add_collection') %> 
            <% } else if (view === 'add_box') { %> 
                <%- include('./partials/_add_box') %> 
            <% } else { %> 
                <%- include('./partials/_empty_state') %> 
            <% } %>
        <% } %>
      </section>
    </main>

  </div>
</div>

</div>
<!-- End of Experimental Design -->



<%- include('../partials/footer') %>