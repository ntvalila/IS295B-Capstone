<h2 class="fw-bold mb-4">
  Create New Collection
</h2>

<div class="card border-0 shadow-sm p-4">
  <form action="/admin/collections/add" method="POST">
    <div class="mb-4">
      <label class="form-label small fw-bold text-uppercase text-muted"
        >Collection Name</label
      >
      <input
        type="text"
        name="name"
        class="form-control bg-light border-0 py-2"
        placeholder="e.g., University Historical Records"
        required
      />
    </div>

    <div class="mb-4">
      <label class="form-label small fw-bold text-uppercase text-muted"
        >Physical Location</label
      >
      <input
        type="text"
        name="location"
        class="form-control bg-light border-0 py-2"
        placeholder="e.g., Room 302, Shelf B"
        required
      />
    </div>

    <div class="mb-4">
      <label class="form-label small fw-bold text-uppercase text-muted"
        >Description</label
      >
      <textarea
        name="description"
        class="form-control bg-light border-0"
        rows="4"
        placeholder="Briefly describe the scope and content..."
      ></textarea>
    </div>

    <div class="mb-4">
      <label class="form-label small fw-bold text-muted text-uppercase"
        >Restriction Level</label
      >
      <select name="restriction_id" class="form-select bg-light border-0">
        <option value="1">Public</option>
        <option value="2">Confidential</option>
        <option value="3">Restricted</option>
      </select>
    </div>

    <div class="d-flex justify-content-end gap-2 border-top pt-4">
      <a href="/admin/collections" class="btn btn-light px-4">Cancel</a>
      <button type="submit" class="btn btn-maroon px-5 shadow-sm">
        Save Collection
      </button>
    </div>
  </form>
</div>
