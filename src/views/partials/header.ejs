<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PUP Digital Archives</title>
    
    <!--CSS-->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css"
    />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

    <nav class="navbar navbar-expand-lg bg-white border-bottom px-5 py-2 sticky-top">

     <div class="container-fluid">

        <a class="navbar-brand" href="/" style="color:maroon;"><img src="/images/pup-logo.png" alt="Logo" style="height: 60px; width: auto;" class="d-inline-block mx-1"> Digital Archives</a>

        <!-- NAVIGATION LINKS START HERE -->
         
            <ul class="nav justify-content-end nav-underline">
                
                <li class="nav-item">                    
                    <a class="nav-link"
                    href="/search"
                    style="color:maroon;">
                    <i class="bi bi-search"></i></a>
                </li>
                
                <% if (user) { %>
                <li class="nav-item">                    
                    <a class="nav-link"
                    href="/home"
                    style="color:maroon;">
                    Dashboard</a>
                </li>

                <% } if (locals.type == 1) { %>
                
                <li class="nav-item">
                    <a class="nav-link <%= (locals.path === '/admin/manage_users') ? 'active text-decoration-none' : '' %>"
                    href="/admin/manage_users"
                    style="color:maroon;">User Management</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link"
                    href="/admin/collections"
                    style="color:maroon;">Collection Management</a>
                </li>
                
                <% } if (user) { %>

                <li class="nav-item">
                    <a class="nav-link"
                    href="/logout"
                    style="color:rgb(0, 0, 0);">Logout</a>
                </li>
                
                <% } if (!user) { %>
                
                <li class="nav-item">
                    <a class="nav-link"
                    href="/login"
                    style="color:maroon;">Login</a>
                </li>
                    
                <li class="nav-item">
                    <a class="nav-link"
                    href="/register"
                    style="color:maroon;">Register</a>
                </li>

                <% } %>
                
            </ul>
        
    <!-- END OF NAV LINKS -->
     </div>
    </nav>

</body>
</html>