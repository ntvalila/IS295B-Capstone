{
    "version": 2,
    "builds": [
        {
            "src": "src/app.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/css/:path*",
            "destination": "/public/css/:path*"
        },
        {
            "source": "/js/:path*",
            "destination": "/public/js/:path*"
        },
        {
            "source": "/images/:path*",
            "destination": "/public/images/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/src/app.js"
        }
    ]
}